<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:backgroundTint="#CC000000"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/subs_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/subs_waiting_for_audio"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:breakStrategy="simple"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <!-- Explicit AppCompat widget so app:tint applies even though this
             overlay is inflated from a plain Service context (no AppCompat
             LayoutInflater factory). -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_close_subs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:padding="8dp"/>

    </LinearLayout>
</FrameLayout>
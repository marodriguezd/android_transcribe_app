# ==============================================================================
# Aura Transcribe - Fastlane Appfile Configuration
# ==============================================================================
# Configures the package name and Google Play API credentials for fastlane
# tools like 'supply' (upload_to_play_store).
# ==============================================================================

# Path to the Google Play Developer API service account JSON key.
# Resolves from environment variable SUPPLY_JSON_KEY or GOOGLE_PLAY_KEY_FILE.
# In CI/CD pipelines, this can be decoded from a secret (e.g. PLAY_STORE_JSON_KEY).
json_key_file(ENV["SUPPLY_JSON_KEY"] || ENV["GOOGLE_PLAY_KEY_FILE"] || "fastlane/play_store_key.json")

# The package identifier of the Android application.
package_name("com.auratranscribe.app")

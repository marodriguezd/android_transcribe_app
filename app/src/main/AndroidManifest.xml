<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app runs inference on the CPU (ggml); GLES 3.2 is not used.
         required=false so devices/emulators without a GLES 3.2 driver can
         still install the app. -->
    <uses-feature android:glEsVersion="0x00030002" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- AI post-processing (fork addition): calls an OpenAI-compatible API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Access Android system user dictionary (FUTO Keyboard style) -->
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />

    <!-- Package visibility (Android 11+): lets resolveActivity()/queryIntentActivities()
         for the speech intent see other handlers, so MainActivity can tell whether this
         app is the resolved handler or a chooser would appear. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:hasCode="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Speech model management -->
        <activity
            android:name=".ModelsActivity"
            android:label="@string/models_title"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false" />

        <!-- AI post-processing settings (fork addition) -->
        <activity
            android:name=".PostProcessSettingsActivity"
            android:label="@string/pp_card_title"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false" />

        <!-- Custom words dictionary editor (fork addition) -->
        <activity
            android:name=".CustomWordsActivity"
            android:label="@string/cw_title"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false" />

        <!-- Live Subtitles Activity: configuration + permissions. Uses the app
             theme so the screen is a normal (opaque) start/config page where
             the user picks the translation target before starting. -->
        <activity
            android:name=".LiveSubtitleActivity"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:exported="false" />
            
        <!-- RecognizerIntent entry point (for SwiftKey chooser) -->
        <activity
            android:name=".RecognizeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/AppTheme.VoicePanel">

            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- Transcribe shared audio file -->
        <activity
            android:name=".TranscribeFileActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme">

            <!-- Handle "Share" from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Handle "Open with" for audio files. tools:ignore is justified:
                 this is an audio/* mime handler, not an app link — there is no
                 http(s) URL/domain to verify, so AppLinkUrlError is a false
                 positive here (adding autoVerify would claim a fake domain). -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Live Subtitles Service -->
        <service
            android:name=".LiveSubtitleService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Speech-to-text provider for other keyboards (SwiftKey, Gboard, …).
             Declared in the manifest so it is always discoverable via
             SpeechRecognizer, even when the app process isn't running. -->
        <service
            android:name=".VoiceRecognitionService"
            android:label="@string/recognition_service_label"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- IME Service -->
        <service
            android:name=".RustInputMethodService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_launcher_aura_transcribe"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:process=":ime"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Accessibility Service for floating dictation auto-paste -->
        <service
            android:name=".FloatingDictationAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Floating Overlay Service. stopWithTask=false so the bubble survives
             swiping the app out of recents (a floating dictation bubble is meant
             to keep working while you use other apps). -->
        <service
            android:name=".FloatingOverlayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
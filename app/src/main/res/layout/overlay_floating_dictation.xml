<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed Floating Bubble View -->
    <FrameLayout
        android:id="@+id/floating_bubble_root"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <dev.notune.transcribe.MicLevelView
            android:id="@+id/floating_bubble_mic_level"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/floating_bubble_circle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_record_circle" />

        <ImageView
            android:id="@+id/floating_bubble_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/floating_bubble_description"
            android:src="@drawable/ic_mic"
            app:tint="?attr/colorOnPrimary" />
    </FrameLayout>

    <!-- Expanded Dictation Panel View -->
    <LinearLayout
        android:id="@+id/floating_panel_root"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_voice_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Header status & actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/floating_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:paddingStart="4dp"
                android:singleLine="true"
                android:text="@string/floating_status_idle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <ProgressBar
                android:id="@+id/floating_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/floating_pp_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/floating_ai_fix_toggle"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <Button
                android:id="@+id/floating_cancel_button"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/floating_action_cancel"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/floating_close_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Live partial hypothesis text -->
        <ScrollView
            android:id="@+id/floating_partial_scroll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/floating_partial_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />
        </ScrollView>

        <!-- Record & Insert buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <FrameLayout
                android:id="@+id/floating_record_container"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:clickable="true"
                android:focusable="true">

                <dev.notune.transcribe.MicLevelView
                    android:id="@+id/floating_mic_level"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center" />

                <View
                    android:id="@+id/floating_record_circle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_record_circle" />

                <ImageView
                    android:id="@+id/floating_mic_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/section_ime"
                    android:src="@drawable/ic_mic"
                    app:tint="?attr/colorOnPrimary" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/floating_insert_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/floating_action_insert"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
